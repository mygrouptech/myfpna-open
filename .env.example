# MyFPnA Unified Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# LICENSE CONFIGURATION
# ============================================================================
# Set to 'open' for open-source version or 'premium' for premium version
LICENSE_TYPE=open

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=mysql://user:password@localhost:3306/myfpna

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ============================================================================
# AUTHENTICATION
# ============================================================================
# For open-source: Magic Link authentication
MAGIC_LINK_SECRET=your-secret-key-here

# For premium: Manus OAuth (optional, can run alongside Magic Link)
OAUTH_SERVER_URL=https://oauth.manus.space
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Session configuration
SESSION_SECRET=your-session-secret-here

# ============================================================================
# AI SERVICES (Premium only - optional for open-source)
# ============================================================================
# OpenAI (GPT-4)
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Manus Forge
BUILT_IN_FORGE_API_KEY=your-forge-key

# ============================================================================
# STRIPE (Premium only - for donations)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# FILE STORAGE (Optional)
# ============================================================================
# AWS S3 for file uploads and exports
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=myfpna-files

# ============================================================================
# EMAIL (Optional)
# ============================================================================
# For sending magic link emails and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=MyFPnA <noreply@myfpna.com>

# ============================================================================
# FEATURE FLAGS (Override defaults)
# ============================================================================
# Enable/disable specific features (true/false)
ENABLE_AI_FORECASTING=false
ENABLE_AI_ANOMALY_DETECTION=false
ENABLE_AI_COMMENTARY=false
ENABLE_STRIPE_DONATIONS=false
ENABLE_PDF_EXPORT=false
ENABLE_EXCEL_EXPORT=false

# ============================================================================
# RATE LIMITING (Premium only)
# ============================================================================
# AI forecast limits per month
AI_FORECAST_LIMIT_FREE=10
AI_FORECAST_LIMIT_DONOR=unlimited

# ============================================================================
# MONITORING & LOGGING (Optional)
# ============================================================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# ============================================================================
# DEVELOPMENT (Optional)
# ============================================================================
# Enable debug mode
DEBUG=false

# Seed database with test data
SEED_DATABASE=false
